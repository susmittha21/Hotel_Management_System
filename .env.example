DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_management_DBMS
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=
# Local development URI; for deployment, set MONGO_URI to your hosted MongoDB
# connection string in the backend host's environment/secrets.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=hotel_mongodb
# For LAN access, add the frontend origin (for example, http://<server-lan-ip>:3000).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
PMS_SESSION_SECRET=
PMS_COOKIE_SECURE=false
PMS_MANAGER_USERNAME=
PMS_MANAGER_PASSWORD=
PMS_FRONT_DESK_USERNAME=
PMS_FRONT_DESK_PASSWORD=
PMS_ACCOUNTS_USERNAME=
PMS_ACCOUNTS_PASSWORD=
PMS_GST_RATE=5
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# SMTP settings for guest password reset emails. Use an app password where required.
PMS_SMTP_HOST=
PMS_SMTP_PORT=587
PMS_SMTP_USERNAME=
PMS_SMTP_PASSWORD=
PMS_SMTP_FROM=
PMS_GUEST_RESET_URL=http://localhost:3000/pages/guest-account.html
